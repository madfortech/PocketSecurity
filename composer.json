{
    "name": "pocketphp/pocketsecurity",
    "description": "Security library for Pocket PHP boilerplate",
    "type": "library",
    "require": {
        "php": ">=8.2"
    },
    "authors": [
        {
            "name": "Himanshu Nishad"
        }
    ],
    "version": "1.0.1-alpha",
    "autoload": {
        "psr-4": {
            "PocketSecurity\\": "src/"
        }
    },
    "repositories": [
    {
        "type": "vcs",
        "url": "https://github.com/madfortech/PocketTesting"
    }
    ],
    "minimum-stability": "alpha",
    "require-dev": {
        "pocketphp/pocket-testing": "dev-main"
    }
}
